 import { removeBuriedCode } from '../src/github/prCreator';
 
 test('C# remover deletes method with DeadCode attribute', () => {
   const src = `[DeadCode(expiry: "2020-01-01", reason: "x")]
 public void OldMethod() { }
 public void Keep() { }`;
   const item: any = { filePath: 'tmp.cs', lineNumber: 1, functionName: 'OldMethod', language: 'csharp', expiry: new Date('2020-01-01'), reason: 'x' };
   const out = removeBuriedCode(src, item);
   expect(out).not.toContain('OldMethod');
   expect(out).toContain('Keep');
 });
 
