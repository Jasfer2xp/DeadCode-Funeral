{
  "name": "deadcode-funeral",
  "version": "1.0.0",
  "description": "Schedule your dead code for deletion. Automatically.",
  "bin": {
    "deadcode-funeral": "./dist/cli/index.js"
  },
  "type": "module",
  "dependencies": {
    "tree-sitter": "^0.21.0",
    "tree-sitter-typescript": "^0.21.0",
    "tree-sitter-c-sharp": "^0.21.0",
    "tree-sitter-python": "^0.21.0",
    "tree-sitter-javascript": "^0.21.0",
    "@octokit/rest": "^20.0.0",
    "commander": "^12.0.0",
    "glob": "^10.0.0",
    "chalk": "^5.0.0",
    "simple-git": "^3.0.0"
  },
  "optionalDependencies": {
    "tree-sitter-php": "^0.21.0"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "ts-jest": "^29.0.0",
    "@types/jest": "^29.0.0",
    "ts-node": "^10.9.0",
    "vsce": "^2.0.0"
  },
  "scripts": {
      "generate-diffs": "node scripts/generate_removal_diffs.cjs",
      "generate-diffs-cjs": "node scripts/generate_removal_diffs.cjs",
    "build": "tsc -p tsconfig.json",
    "test": "jest --config jest.config.cjs",
    "scan": "npx deadcode-funeral scan --path .",
    "scan:dry": "npx deadcode-funeral scan --path . --dry-run",
    "open-pr": "npx deadcode-funeral open-pr --path .",
    "open-pr:dry": "npx deadcode-funeral open-pr --path . --dry-run",
    "build:action": "echo 'action entry is JS; no build required'",
    "prepare": "echo 'skipping prepare build'",
    "prepublishOnly": "npm run build",
    "release": "npm run build && npm version patch -m \"chore(release): %s\"",
    "package:vsix": "cd vscode-extension && vsce package --out ../deadcode-funeral.vsix",
    "publish:vsce": "cd vscode-extension && vsce publish",
    "publish:npm": "npm publish --access public || true"
  }
}
